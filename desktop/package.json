{
  "name": "mulacord-desktop",
  "version": "1.4.0",
  "description": "App desktop do Mulacord (Electron)",
  "main": "electron/main.js",
  "author": "Mulacord",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/start.js --dev",
    "cert": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-cert.ps1",
    "build:server": "node scripts/build-server.js",
    "build:art": "node scripts/make-installer-art.js",
    "icon": "node scripts/postbuild.js",
    "prep": "node scripts/obfuscate.js && node scripts/make-installer-art.js && node scripts/postbuild.js",
    "dist": "npm run cert && npm run build:server && npm run prep && electron-builder --win --publish never",
    "dist:dir": "npm run build:server && npm run prep && electron-builder --win --dir"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.2.2",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "com.mullacord.desktop",
    "productName": "Mulla Cord",
    "executableName": "MullaCord",
    "copyright": "Copyright © 2026 Mulla Cord",
    "directories": {
      "buildResources": "build",
      "output": "dist-installer"
    },
    "afterPack": "./scripts/afterPack.js",
    "afterAllArtifactBuild": "./scripts/afterAllArtifactBuild.js",
    "files": [
      "electron/**/*",
      { "from": "src.dist", "to": "src", "filter": ["**/*", "!**/*.map"] },
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../server/dist/mulacord-server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "protocols": [
      {
        "name": "Mulla Cord",
        "schemes": [
          "mula"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "publisherName": "Mulla Cord",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "MullaCord-portable-${version}.exe",
      "unpackDirName": "MullaCord",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mulla Cord",
      "menuCategory": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "uninstallDisplayName": "Mulla Cord ${version}",
      "include": "build/installer.nsh",
      "artifactName": "MullaCord-Setup-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    }
  }
}
